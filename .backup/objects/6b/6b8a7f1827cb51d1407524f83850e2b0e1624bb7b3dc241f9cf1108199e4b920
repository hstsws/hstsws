#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""分析验证码图片像素特征：确认字体/颜色/干扰，为模板匹配做准备"""
from PIL import Image
import io, collections

for i in range(3):
    img = Image.open('/tmp/vcode_%d.jpg' % i).convert('RGB')
    w, h = img.size
    px = img.load()
    # 统计颜色分布
    colors = collections.Counter()
    for y in range(h):
        for x in range(w):
            colors[px[x, y]] += 1
    print('img%d %dx%d top colors:' % (i, w, h))
    for c, n in colors.most_common(8):
        print('   %s x%d' % (c, n))

# 输出灰度直方图
print('\n灰度分布（按亮度统计 16 桶）:')
for i in range(3):
    img = Image.open('/tmp/vcode_%d.jpg' % i).convert('L')
    his = [0] * 16
    for p in img.getdata():
        his[p // 16] += 1
    print('img%d:' % i, his)