#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""验证码对比度增强 ASCII"""
from PIL import Image
import glob

for p in sorted(glob.glob('/tmp/vcodes/*.jpg'))[:3]:
    img = Image.open(p).convert('L')
    # 直接放大3x，不二值化，用亮度梯度
    img = img.resize((img.width * 3, img.height * 3), Image.LANCZOS)
    w, h = img.size
    print('==== %s ====' % p.split('/')[-1])
    chars = ' .+*#@'
    for y in range(h):
        row = ''
        for x in range(w):
            v = img.getpixel((x, y))
            # 暗=>@，亮=>空格
            idx = min(5, (255 - v) * 6 // 256) if v < 180 else 0
            row += chars[idx]
        print(row)